generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SagaStatus {
  STARTED
  AWAITING_QUOTE_APPROVAL
  PAYMENT_CONFIRMED
  EXECUTION_STARTED
  COMPLETED
  COMPENSATING
  COMPENSATED
  FAILED
}

model SagaInstance {
  id             String     @id @default(uuid())
  osId           String?
  budgetId       String?
  status         SagaStatus @default(STARTED)
  correlationId  String
  completedSteps String[]   @default([])
  lastError      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([osId])
  @@index([correlationId])
  @@map("saga_instances")
}
